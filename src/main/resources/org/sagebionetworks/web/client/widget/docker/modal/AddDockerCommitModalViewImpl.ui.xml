<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
    xmlns:bh="urn:import:org.gwtbootstrap3.client.ui.html"
    xmlns:w="urn:import:org.sagebionetworks.web.client.widget">

  <b:Modal ui:field="addDockerCommitModal">
    <b:ModalBody>
      <bh:Div ui:field="synAlertContainer"/>
      
      <b:FieldSet>
        <b:FormGroup>
          <b:FormLabel for="digestTextBox">Docker Image Digest</b:FormLabel>
          <w:HelpWidget helpMarkdown="The SHA256 digest of the Docker image (required)" addStyleNames="margin-left-5 moveup-1"/>
          <b:TextBox ui:field="digestTextBox" 
                     placeholder="sha256:abc123def456..." 
                     addStyleNames="form-control"/>
        </b:FormGroup>
        
        <b:FormGroup>
          <b:FormLabel for="tagTextBox">Tag (Optional)</b:FormLabel>
          <w:HelpWidget helpMarkdown="An optional tag to identify this commit" addStyleNames="margin-left-5 moveup-1"/>
          <b:TextBox ui:field="tagTextBox" 
                     placeholder="e.g., v1.0.0" 
                     addStyleNames="form-control"/>
        </b:FormGroup>
      </b:FieldSet>
    </b:ModalBody>
    
    <b:ModalFooter>
      <b:Button ui:field="cancelButton" type="DEFAULT" text="Cancel"/>
      <b:Button ui:field="saveButton" type="PRIMARY" text="Add Commit"/>
    </b:ModalFooter>
  </b:Modal>

</ui:UiBinder>