<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder
  xmlns:ui="urn:ui:com.google.gwt.uibinder"
  xmlns:g="urn:import:com.google.gwt.user.client.ui"
  xmlns:b="urn:import:org.gwtbootstrap3.client.ui"
  xmlns:MUI="urn:import:org.sagebionetworks.web.client.jsinterop.mui"
  xmlns:bh="urn:import:org.gwtbootstrap3.client.ui.html"
  xmlns:w="urn:import:org.sagebionetworks.web.client.widget"
>
  <bh:Div addStyleNames="entityPageContentRow">
    <g:FlowPanel addStyleNames="filesTabContent entityPageMainContent">
    <w:LoadingSpinner
      ui:field="loading"
      size="31px"
      addStyleNames="center-block center min-height-400"
    />
    <g:SimplePanel ui:field="refreshAlertContainer" />
    <g:SimplePanel ui:field="synapseAlertContainer" />
    <bh:Div ui:field="modalDialogContainer" />
    <g:SimplePanel ui:field="fileBreadcrumbContainer" />
    <bh:Div addStyleNames="entity-page-side-margins">
      <g:SimplePanel ui:field="folderTitlebarContainer" visible="false" />
      <g:SimplePanel ui:field="fileTitlebarContainer" visible="false" />
      <g:SimplePanel ui:field="fileMetadataContainer" visible="false" />
    </bh:Div>
    <g:SimplePanel ui:field="addToDownloadListWidgetContainer" />
    <bh:Div addStyleNames="entity-page-side-margins margin-bottom-40">
      <g:SimplePanel ui:field="fileHistoryContainer" />
      <g:SimplePanel
        ui:field="filesWikiPageContainer"
        addStyleNames="panel panel-default panel-body margin-bottom-0-imp"
        visible="false"
      />
      <g:SimplePanel ui:field="fileBrowserContainer" />
      <MUI:Grid
        container="true"
        columnSpacing="15px"
        rowSpacing="15px"
        addStyleNames="margin-top-10"
      >
        <MUI:Grid xs="12" md="6" ui:field="filePreviewContainer">
          <g:FlowPanel>
            <bh:Div addStyleNames="entity-title">
              <bh:Text>Preview</bh:Text>
              <b:Anchor
                addStyleNames="lightGreyText"
                icon="ARROWS_ALT"
                ui:field="expandPreviewLink"
                pull="RIGHT"
              />
            </bh:Div>
            <bh:Div addStyleNames="contentSectionContainer padding-15">
              <bh:Div ui:field="filePreviewWidgetContainer" addStyleNames="file-preview-video-container" />
            </bh:Div>
          </g:FlowPanel>
        </MUI:Grid>
        <MUI:Grid xs="12" md="6">
          <g:FlowPanel ui:field="fileProvenanceContainer">
            <bh:Div addStyleNames="entity-title">
              <bh:Text>File Provenance</bh:Text>
              <b:Anchor
                addStyleNames="lightGreyText"
                icon="ARROWS_ALT"
                ui:field="expandProvenanceLink"
                pull="RIGHT"
              />
            </bh:Div>
            <bh:Div addStyleNames="contentSectionContainer padding-15">
              <bh:Div
                ui:field="fileProvenanceGraphContainer"
              />
            </bh:Div>
          </g:FlowPanel>
        </MUI:Grid>
      </MUI:Grid>
      <g:FlowPanel ui:field="discussionContainer" addStyleNames="margin-top-10">
        <bh:Div addStyleNames="entity-title">
          <bh:Text ui:field="discussionText" />
        </bh:Div>
          <bh:Div ui:field="discussionThreadsContainer" />
      </g:FlowPanel>
    </bh:Div>
    <g:SimplePanel ui:field="fileModifiedAndCreatedContainer" />
    </g:FlowPanel>
    <w:ReactComponent ui:field="entitySidebar" addStyleNames="entityPageSidebar" />
  </bh:Div>
</ui:UiBinder>
